//
//  TuringSimTests.xcconfig
//  TuringSim
//
//  Unit test bundle hosted in TuringSim.app on iOS, iPadOS, and macOS.
//

#include "Multiplatform.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.roedesigns.play.TuringSimTests
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES

// BUNDLE_EXECUTABLE_FOLDER_PATH resolves to Contents/MacOS on macOS and to the bundle root on iOS.
TEST_HOST = $(BUILT_PRODUCTS_DIR)/TuringSim.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/TuringSim
BUNDLE_LOADER = $(TEST_HOST)

SWIFT_VERSION = 5.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_EMIT_LOC_STRINGS = NO
STRING_CATALOG_GENERATE_SYMBOLS = NO
